ADMIN_TOKEN=اختر_كلمة_سر_طويلة_وعشوائية
FREE_DAILY_CHARS=1000
FREE_MAX_PER_REQUEST=300
PAID_MAX_PER_REQUEST=1500
# عدد الطلبات المسموح بانتظارها قبل رفض الطلبات الجديدة
MAX_QUEUE=8
# جودة التوليد: القيم الأعلى (مثل 64) أبطأ وقد تقلل التكرار
NFE_STEP=32
CFG_STRENGTH=2.0
# اجعله يشير إلى قرص دائم عند النشر حتى لا تضيع الأكواد
DATA_DIR=.
# اختياري: مسارات محلية للنموذج بدل التحميل من Hugging Face
# CKPT_PATH=/models/ALGERIA.safetensors
# VOCAB_PATH=/models/vocab.txt
# لتجربة الواجهة بدون GPU
# SKIP_MODEL=1
